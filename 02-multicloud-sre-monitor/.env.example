# ==============================================================================
# 🔐 TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para `.env` em testes locais ou configure no Cloud Run Job.
# NUNCA versione chaves reais no Git.

# Projeto GCP alvo para coleta do Cloud Monitoring e Compute Engine
GCP_PROJECT_ID="acme-core-prod-pool"

# Modo de operação: REPORT (relatório completo agendado) ou HEARTBEAT (silencioso se saudável)
MONITOR_MODE="REPORT"

# Webhook do Google Chat (Cards V2)
WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/SEU_SPACE_ID/messages?key=SUA_API_KEY&token=SEU_TOKEN"

# IDs dos Dashboards no Cloud Monitoring (Opcional)
DASHBOARD_LOAD_ID="00000000-1111-2222-3333-444444444444"
DASHBOARD_COMMAND_CENTER_ID="55555555-6666-7777-8888-999999999999"

# Credenciais IAM Read-Only para telemetria de reputação do Amazon SES + CloudWatch
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AWS_DEFAULT_REGION="us-east-1"

# Flag opcional para simular falhas em ambiente de desenvolvimento local
FORCE_MOCK_ERRORS="false"
